# BookStack Environment Configuration
# Copy this file to .env.bookstack and fill in your actual values

# ============================================
# BookStack Core Settings
# ============================================
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your-random-key-here
APP_URL=https://bookstack.shannonjlove.cloud

# ============================================
# Database Configuration
# ============================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=your-secure-password-here
DB_COLLATION=utf8mb4_unicode_ci

# ============================================
# Authentication Settings
# ============================================
# Default admin user (create on first setup)
ADMIN_EMAIL=admin@shannonjlove.cloud
ADMIN_NAME=Administrator
ADMIN_PASSWORD=your-admin-password-here

# ============================================
# Mail Configuration (optional)
# ============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="BookStack"
MAIL_FROM_ADDRESS=noreply@shannonjlove.cloud

# ============================================
# Session & Security
# ============================================
SESSION_DRIVER=cookie
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# ============================================
# API Token (Generated after installation)
# ============================================
# These will be generated through the UI
# Store securely after generation
BOOKSTACK_TOKEN_ID=0GfibwREHLX4Li8eXoPrARcIkZJjs9n1
BOOKSTACK_TOKEN_SECRET=5UCfFgn4GlRIIl65VaGUF6Nr8i6s4JRi

# ============================================
# Cache Configuration
# ============================================
CACHE_DRIVER=file
QUEUE_DRIVER=sync

# ============================================
# Optional Features
# ============================================
# Enable or disable specific features
ALLOW_CONTENT_EXPORTS=true
ALLOW_USER_REGISTRATION=false
